# Copia este archivo como .env.local para desarrollo local.
# No subas .env.local a GitHub.

# false = FileMaker real. true = datos de prueba.
VITE_USE_MOCK=false

# Si la web se sirve desde el mismo origen que FileMaker Server, puedes dejarlo vacío.
# Para desarrollo con Vite, si hay CORS, usa la URL/IP local del Mac mini, por ejemplo:
# VITE_FM_HOST=https://192.168.1.14
VITE_FM_HOST=

# Proxy local de desarrollo hacia FileMaker Server.
# Ejemplo: https://localhost o https://192.168.1.14
VITE_DEV_FM_PROXY_TARGET=https://localhost
# Host del servidor Vite (0.0.0.0 permite acceso por IP de red)
# VITE_DEV_SERVER_HOST=0.0.0.0
# VITE_DEV_PORT=5174
# HTTPS en desarrollo (true por defecto; pon false para HTTP)
# VITE_DEV_HTTPS=true

# Google Maps Platform Geocoding API. Rellenar solo en .env.local.
GOOGLE_MAPS_API_KEY=

# Nombre de la base sin .fmp12
VITE_FM_DATABASE=GestionPericial

# Layout API usado por la pantalla inicial de enlaces/siniestros en curso
VITE_FM_LAYOUT=API_EnlacesSiniestros

# Layouts API del modelo principal
VITE_FM_LAYOUT_ASEGURADOS=API_Asegurados
VITE_FM_LAYOUT_CONTACTOS_ASEGURADO=API_ContactosAsegurado
VITE_FM_LAYOUT_POLIZAS=API_Polizas
# Lista de valores FileMaker del campo Propietario (API_Polizas)
VITE_FM_POLIZA_VALUELIST_PROPIEDAD=Propietario
# Nombres alternativos a probar si la metadata no coincide
# VITE_FM_POLIZA_VALUELISTS_PROPIETARIO=Propietario,Propiedad
# Valores por defecto si FileMaker no devuelve la lista (Propietario / Inquilino)
# VITE_FM_POLIZA_VALORES_PROPIETARIO=Propietario,Inquilino
VITE_FM_POLIZA_CAMPO_PROPIETARIO=Propietario
VITE_FM_LAYOUT_SINIESTROS=API_Siniestros
VITE_FM_LAYOUT_CONTACTOS_SINIESTROS=API_ContactosSiniestros

# Catálogo CP / población / provincia (layout API_CodigosPostales)
VITE_FM_LAYOUT_CODIGOS_POSTALES=API_CodigosPostales

# Códigos de municipio catastro (PoblacionC de póliza ↔ Municipio)
VITE_FM_LAYOUT_CODIGOS_MUNICIPIOS_CATASTRO=API_CodigosMunicipiosCatastro
VITE_FM_CM_CATASTRO_CAMPO_MUNICIPIO=Municipio
VITE_FM_CM_CATASTRO_CAMPO_CODIGO=Codigo
# En layout API_Polizas incluir el campo de relación (como en FileMaker):
# polizas_CAT_CODIGO_MUNICIPIOS::Codigo
VITE_FM_CP_CAMPO_COD_POSTAL=CodigoPostal
VITE_FM_CP_CAMPO_POBLACION=Poblacion
VITE_FM_CP_CAMPO_PROVINCIA=Provincia

# Script FileMaker que genera el enlace y devuelve datos para WhatsApp
VITE_FM_SCRIPT_ENVIAR_ENLACE=SMS

# Script FileMaker que rellena en la póliza la dirección copiándola desde el asegurado
VITE_FM_SCRIPT_RELLENAR_DIRECCION_ASEGURADO="Rellenar direccion asegurado"

# Abre la sede del catastro para la RC de la póliza (misma URL que el Case del guión WebCatastro)
VITE_FM_SCRIPT_WEB_CATASTRO=WebCatastro
# Espera (ms) tras cargar OVCConCiud antes de javascript:ImprimirCroquisYDatos()
VITE_CATASTRO_IMPRIMIR_CROQUIS_MS=4500

# Campos de distancia/coordenadas en API_Polizas (ajusta si en FileMaker se llaman distinto)
VITE_FM_POLIZA_CAMPO_DISTANCIA=Distancia
VITE_FM_POLIZA_CAMPO_LATITUD=Latitud
VITE_FM_POLIZA_CAMPO_LONGITUD=Longitud
# Código postal dirección catastro en API_Polizas
VITE_FM_POLIZA_CAMPO_COD_POSTAL_C=CodPostalC
# Sumatorio parcela (guiones CAT_DetalleCatastro_Parcela_Sumatorios_Usos)
VITE_FM_POLIZA_CAMPO_USOS_PARCELA_JSON=UsosParcelaJSON
VITE_FM_POLIZA_CAMPO_SUP_CONSTRUIDA_TOTAL=SupConstruidaTotal

# Layout API DetalleCatastro (uso y superficie por referencia catastral)
VITE_FM_LAYOUT_DETALLE_CATASTRO=API_detalleCatastro
VITE_FM_DETALLE_CATASTRO_FK_POLIZA=_kf_ID_Poliza
VITE_FM_DETALLE_CATASTRO_CAMPO_REF=Catastro
VITE_FM_DETALLE_CATASTRO_CAMPO_TIPO_USO=Uso
VITE_FM_DETALLE_CATASTRO_CAMPO_SUPERFICIE=Superficie

# Layout API DetalleCatastroParcela (inmuebles de una parcela catastral)
VITE_FM_LAYOUT_DETALLE_CATASTRO_PARCELA=API_DetalleCatastroParcela
VITE_FM_DETALLE_CATASTRO_PARCELA_FK_POLIZA=_kf_ID_Poliza
VITE_FM_DETALLE_CATASTRO_PARCELA_CAMPO_REF=RC

# Layout API DetalleContinente (preexistencia de continente por póliza)
VITE_FM_LAYOUT_DETALLE_CONTINENTE=API_DetalleContinente
VITE_FM_DETALLE_CONTINENTE_FK_POLIZA=_kf_ID_Poliza
VITE_FM_DETALLE_CONTINENTE_FK_TIPOLOGIA=_kf_ID_Tipologias
VITE_FM_DETALLE_CONTINENTE_CAMPO_MEDICION=Medicion
VITE_FM_DETALLE_CONTINENTE_CAMPO_PRECIO=Precio
VITE_FM_DETALLE_CONTINENTE_CAMPO_IMPORTE=Importe
VITE_FM_DETALLE_CONTINENTE_CAMPO_CLAVE=ClavePrincipal

# Layout API TipologiasContinente (catálogo de tipologías de continente)
VITE_FM_LAYOUT_TIPOLOGIAS_CONTINENTE=API_TipologiasContinente
VITE_FM_TIPOLOGIA_CONTINENTE_CAMPO_CLAVE=ClavePrincipal
VITE_FM_TIPOLOGIA_CONTINENTE_CAMPO_NOMBRE=TipoContinente
VITE_FM_TIPOLOGIA_CONTINENTE_CAMPO_PRECIO=Precio

# Filtro para siniestros en curso: FechaCierre vacía
VITE_FM_FILTRO_EN_CURSO_CAMPO=FechaCierre
VITE_FM_FILTRO_EN_CURSO_VALOR==

# Listado asignados (conteo anual en API_Siniestros)
# VITE_FM_SINIESTRO_CAMPO_FECHA_ASIGNACION=FechaEncargo
# VITE_FM_SINIESTRO_CAMPO_ANO_ASIGNACION=AnoEncargo
# VITE_FM_SINIESTRO_CAMPO_COMPANIA=_kf_ID_Compania
# Alias de compañía en API_Siniestros (campo relacionado en el layout)
# VITE_FM_SINIESTRO_CAMPO_ALIAS=Alias
