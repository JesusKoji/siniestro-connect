# Copia este archivo como .env.local para desarrollo local.
# No subas .env.local a GitHub.

# false = FileMaker real. true = datos de prueba.
VITE_USE_MOCK=false

# Si la web se sirve desde el mismo origen que FileMaker Server, puedes dejarlo vacío.
# Para desarrollo con Vite, si hay CORS, usa la URL/IP local del Mac mini, por ejemplo:
# VITE_FM_HOST=https://192.168.1.14
VITE_FM_HOST=

# Nombre de la base sin .fmp12
VITE_FM_DATABASE=GestionPericial

# Layout API usado por la pantalla inicial de enlaces/siniestros en curso
VITE_FM_LAYOUT=API_EnlacesSiniestros

# Layouts API del modelo principal
VITE_FM_LAYOUT_ASEGURADOS=API_Asegurados
VITE_FM_LAYOUT_CONTACTOS_ASEGURADO=API_ContactosAsegurado
VITE_FM_LAYOUT_POLIZAS=API_Polizas
VITE_FM_LAYOUT_SINIESTROS=API_Siniestros
VITE_FM_LAYOUT_CONTACTOS_SINIESTROS=API_ContactosSiniestros

# Script FileMaker que genera el enlace y devuelve datos para WhatsApp
VITE_FM_SCRIPT_ENVIAR_ENLACE=SMS

# Filtro para siniestros en curso: FechaCierre vacía
VITE_FM_FILTRO_EN_CURSO_CAMPO=FechaCierre
VITE_FM_FILTRO_EN_CURSO_VALOR==
