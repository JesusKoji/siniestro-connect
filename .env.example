# Copia este archivo como .env.local para desarrollo local.
# No subas .env.local a GitHub.

# true = datos de prueba. false = FileMaker real.
VITE_USE_MOCK=true

# Si la web se sirve desde el mismo origen que FileMaker Server, puedes dejarlo vacío.
# Para desarrollo, por ejemplo: https://192.168.1.14
VITE_FM_HOST=

# Nombre de la base sin .fmp12
VITE_FM_DATABASE=GestionPericial

# Layout API que contiene los campos necesarios
VITE_FM_LAYOUT=API_EnlacesSiniestros

# Script FileMaker que genera el enlace y devuelve datos para WhatsApp
VITE_FM_SCRIPT_ENVIAR_ENLACE=SMS

# Filtro para siniestros en curso: FechaCierre vacía
VITE_FM_FILTRO_EN_CURSO_CAMPO=FechaCierre
VITE_FM_FILTRO_EN_CURSO_VALOR==
